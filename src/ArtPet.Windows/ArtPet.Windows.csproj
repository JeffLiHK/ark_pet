<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Media/Sprout.ico</ApplicationIcon>
    <ProjectCharacterDirectory>$(MSBuildProjectDirectory)\..\..\local-data\assets\hoolheyak</ProjectCharacterDirectory>
    <HoolheyakPackDirectory Condition="'$(HoolheyakPackDirectory)' == '' And Exists('$(ProjectCharacterDirectory)\desktop-60\character.json')">$(ProjectCharacterDirectory)\desktop-60</HoolheyakPackDirectory>
    <HoolheyakPackDirectory Condition="'$(HoolheyakPackDirectory)' == ''">$(ProjectCharacterDirectory)\desktop</HoolheyakPackDirectory>
    <!-- WPF starts the process, so the manifest sets DPI awareness before any HWND exists. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Media/Sprout.ico" />
  </ItemGroup>
  <ItemGroup Condition="'$(BundleHoolheyak)' == 'true'">
    <Content Include="$(HoolheyakPackDirectory)\character.json;$(HoolheyakPackDirectory)\**\*.png"
             Link="assets\hoolheyak\%(RecursiveDir)%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CheckHoolheyakPack" BeforeTargets="PrepareForPublish" Condition="'$(BundleHoolheyak)' == 'true'">
    <Exec Command="dotnet run --file &quot;$(MSBuildProjectDirectory)\..\..\scripts\ValidateHoolheyakPack.cs&quot; -- &quot;$(HoolheyakPackDirectory)&quot;" />
  </Target>
</Project>
