<Window x:Class="ArtPet.Windows.Desktop.PetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ArkPet" Width="160" Height="160"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" ShowActivated="False" Topmost="True" Cursor="Hand"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        MouseLeftButtonDown="StartGesture" MouseLeftButtonUp="EndGesture">
    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem x:Name="WardrobeItem" Header="衣櫃…" Visibility="Collapsed" />
            <MenuItem x:Name="SettingsItem" Header="設定…" />
            <MenuItem Header="轉身" Click="TurnPet" />
            <MenuItem x:Name="AddPetItem" Header="新增一隻小人" />
            <MenuItem x:Name="RemovePetItem" Header="移除這隻小人" Visibility="Collapsed" />
            <MenuItem Header="置頂" IsCheckable="True"
                      IsChecked="{Binding PlacementTarget.Topmost, RelativeSource={RelativeSource AncestorType=ContextMenu}, Mode=TwoWay}" />
            <MenuItem Header="隱藏小人" Click="HidePet" />
        </ContextMenu>
    </Window.ContextMenu>
    <Grid>
        <Grid x:Name="ArtworkCanvas">
            <Grid x:Name="ShadowLayer">
                <Grid x:Name="OutlineLayer" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <ScaleTransform x:Name="FacingTransform" />
                    </Grid.RenderTransform>
                    <Image x:Name="CharacterImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                </Grid>
            </Grid>
            <Path x:Name="Breeze" Opacity="0" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center"
                  Stroke="#A8EFD5" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Data="M0,11 Q22,22 50,3 M17,22 Q34,27 58,12" />
        </Grid>
        <Popup x:Name="VoiceBubble" Placement="Custom" PlacementTarget="{Binding ElementName=ArtworkCanvas}"
               AllowsTransparency="True" IsHitTestVisible="False" Opened="ConfigureVoiceBubble">
            <Border MaxWidth="320" Padding="12,8" Background="#F2262530" CornerRadius="10">
                <TextBlock x:Name="VoiceSubtitle" Foreground="White" TextWrapping="Wrap" TextAlignment="Center"
                           FontSize="14" Language="zh-TW" />
            </Border>
        </Popup>
    </Grid>
</Window>
