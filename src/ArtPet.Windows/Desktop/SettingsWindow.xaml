<Window x:Class="ArtPet.Windows.Desktop.SettingsWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Art Pet 設定" Width="640" SizeToContent="Height"
        ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen" KeyDown="CloseOnEscape"
        Background="#161B20" Foreground="#F1F5F7"
        FontFamily="Microsoft JhengHei UI, Segoe UI" FontSize="14" UseLayoutRounding="True">
    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#83DEE1" />
        <SolidColorBrush x:Key="BorderBrush" Color="#40535C" />
        <SolidColorBrush x:Key="PanelBrush" Color="#1D252B" />
        <SolidColorBrush x:Key="InputBrush" Color="#242F37" />
        <SolidColorBrush x:Key="TextBrush" Color="#F1F5F7" />
        <SolidColorBrush x:Key="MutedBrush" Color="#AEC0C9" />
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="23" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>
        <Style x:Key="SettingRow" TargetType="Border">
            <Setter Property="BorderBrush" Value="#354650" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="0,12" />
        </Style>
        <Style TargetType="Label">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,12,0" />
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid Margin="0,0,0,6" MinHeight="42" Background="Transparent">
                            <Border x:Name="NavigationTile" Margin="0,0,5,0" BorderThickness="1" />
                            <Border x:Name="SelectionBar" Width="3" HorizontalAlignment="Left" />
                            <ContentPresenter ContentSource="Header" Margin="14,0,12,0" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavigationTile" Property="Background" Value="#252F37" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter TargetName="NavigationTile" Property="Background" Value="#29404A" />
                                <Setter TargetName="SelectionBar" Property="Background" Value="{StaticResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="NavigationTile" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="Transparent" Padding="10,8">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#304852" />
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#395762" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Width" Value="160" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ToggleBorder" Background="{StaticResource InputBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                            <Path Data="M 0,0 L 4,4 L 8,0" Stroke="{StaticResource Accent}" StrokeThickness="1.5"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ToggleBorder" Property="Background" Value="#30424C" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{StaticResource Accent}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Margin="10,0,30,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />
                            <Border x:Name="FocusBorder" BorderThickness="1" IsHitTestVisible="False" />
                            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Focusable="False"
                                   Placement="Bottom" AllowsTransparency="True">
                                <Border MinWidth="{TemplateBinding ActualWidth}" Background="{StaticResource InputBrush}"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="1">
                                    <ScrollViewer MaxHeight="220" CanContentScroll="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="FocusBorder" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="StepperButton" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Foreground" Value="{StaticResource Accent}" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{StaticResource InputBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#30424C" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#395762" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Padding="24,16" BorderBrush="#354650" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <Path Data="M 0,15 L 8,1 L 13,1 L 5,15 Z" Fill="{StaticResource Accent}"
                      VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock Text="Art Pet" FontWeight="SemiBold" FontSize="16" />
            </StackPanel>
        </Border>
        <TabControl Grid.Row="1" Margin="22,18,22,16" TabStripPlacement="Left" SelectedIndex="0"
                    BorderThickness="0" AutomationProperties.Name="設定分類">
            <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="142" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TabPanel IsItemsHost="True" Margin="0,0,13,0" KeyboardNavigation.TabIndex="1" />
                        <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="#354650"
                                BorderThickness="1" Padding="22,18" MinHeight="325">
                            <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"
                                              KeyboardNavigation.TabIndex="2" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </TabControl.Template>
            <TabItem Header="一般">
                <StackPanel>
                    <TextBlock Text="一般" Style="{StaticResource PageTitle}" />
                    <Border Style="{StaticResource SettingRow}">
                        <DockPanel>
                            <ComboBox x:Name="SizeOptions" DockPanel.Dock="Right"
                                      AutomationProperties.LabeledBy="{Binding ElementName=SizeLabel}" ItemStringFormat="{}{0}%" />
                            <Label x:Name="SizeLabel" Content="縮放大小" Target="{Binding ElementName=SizeOptions}" />
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource SettingRow}">
                        <DockPanel>
                            <ComboBox x:Name="FrameRateOptions" DockPanel.Dock="Right"
                                      AutomationProperties.LabeledBy="{Binding ElementName=FrameRateLabel}" ItemStringFormat="{}{0} FPS" />
                            <Label x:Name="FrameRateLabel" Content="動畫幀率" Target="{Binding ElementName=FrameRateOptions}" />
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource SettingRow}">
                        <DockPanel>
                            <Grid DockPanel.Dock="Right" Width="160" Height="36">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Content="−" Style="{StaticResource StepperButton}"
                                        AutomationProperties.Name="減少待機循環次數" Click="DecreaseIdleLoops" />
                                <TextBox x:Name="IdleLoopsInput" Grid.Column="1" InputScope="Number"
                                         AutomationProperties.LabeledBy="{Binding ElementName=IdleLoopsLabel}"
                                         Background="{StaticResource InputBrush}" Foreground="{StaticResource TextBrush}"
                                         CaretBrush="{StaticResource TextBrush}" BorderBrush="{StaticResource BorderBrush}"
                                         BorderThickness="0,1" VerticalContentAlignment="Center" TextAlignment="Center"
                                         TextChanged="ValidateIdleLoops" PreviewKeyDown="HandleIdleLoopsKey" />
                                <Button Grid.Column="2" Content="+" Style="{StaticResource StepperButton}"
                                        AutomationProperties.Name="增加待機循環次數" Click="IncreaseIdleLoops" />
                            </Grid>
                            <StackPanel VerticalAlignment="Center">
                                <Label x:Name="IdleLoopsLabel" Content="待機循環次數" Target="{Binding ElementName=IdleLoopsInput}" />
                                <TextBlock Text="每個待機動作重複 1–100 次" Style="{StaticResource Hint}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <TextBlock x:Name="IdleLoopsError" Text="請輸入 1 到 100 的整數。"
                               Foreground="#FFB4A6" FontSize="12" Margin="0,6,0,0" Visibility="Collapsed" />
                    <CheckBox x:Name="InteractionModeCheckBox" Content="啟用互動模式"
                              Foreground="{StaticResource TextBrush}" Margin="0,14,0,0" />
                    <TextBlock Text="關閉後滑鼠會穿透小人。可從通知區的設定重新開啟。" Style="{StaticResource Hint}" />
                    <DockPanel Margin="0,14,0,0">
                        <ComboBox x:Name="WalkingSpeedOptions" DockPanel.Dock="Right" VerticalAlignment="Center"
                                  AutomationProperties.LabeledBy="{Binding ElementName=WalkingSpeedLabel}" ItemStringFormat="{}{0}%" />
                        <Label x:Name="WalkingSpeedLabel" DockPanel.Dock="Right" Margin="0,0,12,0"
                               Content="自由模式步速" Target="{Binding ElementName=WalkingSpeedOptions}" />
                        <StackPanel VerticalAlignment="Center">
                            <CheckBox x:Name="FreeModeCheckBox" Content="自由模式" Foreground="{StaticResource TextBrush}" />
                            <TextBlock Text="在目前螢幕散步，偶爾發呆或睡覺。" Style="{StaticResource Hint}" />
                        </StackPanel>
                    </DockPanel>
                    <CheckBox x:Name="PhysicsModeCheckBox" Content="物理模式"
                              Foreground="{StaticResource TextBrush}" Margin="0,14,0,0" />
                    <TextBlock Text="放開小人後，會落到視窗、工作列或螢幕底部。" Style="{StaticResource Hint}" />
                    <CheckBox x:Name="StartupCheckBox" Content="登入 Windows 時啟動 Art Pet"
                              Foreground="{StaticResource TextBrush}" Margin="0,14,0,0" Click="ChangeStartup" />
                    <TextBlock x:Name="StartupStatus" Style="{StaticResource Hint}" Visibility="Collapsed" />
                </StackPanel>
            </TabItem>
            <TabItem Header="外觀">
                <StackPanel>
                    <TextBlock Text="外觀" Style="{StaticResource PageTitle}" />
                    <Border Style="{StaticResource SettingRow}">
                        <DockPanel>
                            <ComboBox x:Name="OutlineOptions" DockPanel.Dock="Right"
                                      AutomationProperties.LabeledBy="{Binding ElementName=OutlineLabel}" />
                            <Label x:Name="OutlineLabel" Content="高亮描邊" Target="{Binding ElementName=OutlineOptions}" />
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource SettingRow}">
                        <DockPanel>
                            <ComboBox x:Name="ShadowOptions" DockPanel.Dock="Right"
                                      AutomationProperties.LabeledBy="{Binding ElementName=ShadowLabel}" />
                            <Label x:Name="ShadowLabel" Content="陰影" Target="{Binding ElementName=ShadowOptions}" />
                        </DockPanel>
                    </Border>
                </StackPanel>
            </TabItem>
            <TabItem Header="語音與字幕">
                <StackPanel>
                    <TextBlock Text="語音與字幕" Style="{StaticResource PageTitle}" />
                    <Border Style="{StaticResource SettingRow}">
                        <DockPanel>
                            <ComboBox x:Name="VoiceOptions" DockPanel.Dock="Right" SelectedValuePath="Tag"
                                      AutomationProperties.LabeledBy="{Binding ElementName=VoiceLabel}">
                                <ComboBoxItem Content="日語" Tag="ja" />
                                <ComboBoxItem Content="中文（普通話）" Tag="zh-CN" />
                            </ComboBox>
                            <Label x:Name="VoiceLabel" Content="語音語言" Target="{Binding ElementName=VoiceOptions}" />
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource SettingRow}">
                        <DockPanel>
                            <ComboBox x:Name="SubtitleOptions" DockPanel.Dock="Right" SelectedValuePath="Tag"
                                      AutomationProperties.LabeledBy="{Binding ElementName=SubtitleLabel}">
                                <ComboBoxItem Content="繁體中文" Tag="zh-TW" />
                                <ComboBoxItem Content="日文" Tag="ja" />
                                <ComboBoxItem Content="關閉字幕" Tag="off" />
                            </ComboBox>
                            <Label x:Name="SubtitleLabel" Content="字幕語言" Target="{Binding ElementName=SubtitleOptions}" />
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource SettingRow}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Width="48" TextAlignment="Right" VerticalAlignment="Center"
                                       Text="{Binding Value, ElementName=VoiceVolume, StringFormat={}{0:0}%}" />
                            <Slider x:Name="VoiceVolume" DockPanel.Dock="Right" Width="148" Maximum="100"
                                    TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                    AutomationProperties.LabeledBy="{Binding ElementName=VolumeLabel}" />
                            <Label x:Name="VolumeLabel" Content="語音音量" Target="{Binding ElementName=VoiceVolume}" />
                        </DockPanel>
                    </Border>
                    <TextBlock Text="可用語音和字幕取決於已匯入的角色素材。" Style="{StaticResource Hint}" Margin="0,14,0,0" />
                </StackPanel>
            </TabItem>
            <TabItem Header="更新">
                <StackPanel>
                    <TextBlock Text="更新" Style="{StaticResource PageTitle}" />
                    <Border Style="{StaticResource SettingRow}">
                        <StackPanel>
                            <TextBlock x:Name="CurrentVersionText" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <WrapPanel>
                                <Button x:Name="CheckUpdateButton" Content="檢查程式更新" Padding="12,6"
                                        Click="CheckForUpdate" />
                                <Button x:Name="InstallUpdateButton" Content="下載並重新啟動" Padding="12,6" Margin="8,0,0,0"
                                        Visibility="Collapsed" Click="InstallUpdate" />
                            </WrapPanel>
                            <TextBlock x:Name="UpdateStatus" Style="{StaticResource Hint}" Margin="0,8,0,0"
                                       AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SettingRow}">
                        <StackPanel>
                            <TextBlock Text="霍爾海雅美術資源" FontWeight="SemiBold" />
                            <TextBlock x:Name="AssetVersionText" Style="{StaticResource Hint}" Margin="0,4,0,8" />
                            <WrapPanel>
                                <Button x:Name="CheckAssetButton" Content="檢查美術更新" Padding="12,6"
                                        Click="CheckForAssets" />
                                <Button x:Name="InstallAssetButton" Content="下載美術資源" Padding="12,6" Margin="8,0,0,0"
                                        Visibility="Collapsed" Click="InstallAssets" />
                            </WrapPanel>
                            <TextBlock x:Name="AssetStatus" Style="{StaticResource Hint}" Margin="0,8,0,0"
                                       AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>
        </TabControl>
        <TextBlock Grid.Row="2" Text="設定會自動儲存" Foreground="{StaticResource MutedBrush}"
                   FontSize="12" HorizontalAlignment="Right" Margin="0,0,22,14" />
    </Grid>
</Window>
