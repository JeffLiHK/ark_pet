<Window x:Class="ArtPet.Windows.Wardrobe.WardrobeWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Art Pet 衣櫃" Width="470" Height="588" MinWidth="290" MinHeight="240"
        Background="#131B20" Foreground="#F5F5EE" FontFamily="Microsoft JhengHei UI, Segoe UI" FontSize="14"
        UseLayoutRounding="True" PreviewKeyDown="CloseOnEscape">
    <Window.Resources>
        <ItemsPanelTemplate x:Key="CardPanel">
            <WrapPanel />
        </ItemsPanelTemplate>
        <Style x:Key="CardButton" TargetType="Button">
            <Setter Property="Foreground" Value="#F5F5EE" />
            <Setter Property="Background" Value="#263137" />
            <Setter Property="BorderBrush" Value="#495A60" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Padding" Value="3" />
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"
                                CornerRadius="9" SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#93AAA7" />
                </Trigger>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter Property="BorderBrush" Value="#7EDEC3" />
                </DataTrigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#FFF2C2" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BackButtonStyle" TargetType="Button" BasedOn="{StaticResource CardButton}">
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="ProfessionFilterItem" TargetType="ListBoxItem">
            <Setter Property="Background" Value="#263137" />
            <Setter Property="BorderBrush" Value="#495A60" />
            <Setter Property="Foreground" Value="#F5F5EE" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="ToolTip" Value="{Binding Name}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#93AAA7" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#35534E" />
                    <Setter Property="BorderBrush" Value="#7EDEC3" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#FFF2C2" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <RadialGradientBrush x:Key="PreviewBackground" Center="0.5,0.43" RadiusX="0.72" RadiusY="0.72">
            <GradientStop Color="#63847C" Offset="0" />
            <GradientStop Color="#293F40" Offset="1" />
        </RadialGradientBrush>
        <LinearGradientBrush x:Key="PortraitBackground" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#455A59" Offset="0" />
            <GradientStop Color="#253236" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="PortraitCaptionShade" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#0011191D" Offset="0" />
            <GradientStop Color="#C511191D" Offset="0.67" />
            <GradientStop Color="#F411191D" Offset="1" />
        </LinearGradientBrush>
        <Style x:Key="ImageStatus" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E2EAE6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SelectionStatus" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#D6E4DF" />
            <Setter Property="FontSize" Value="13" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter Property="Foreground" Value="#9BEBCE" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasError}" Value="True">
                    <Setter Property="Foreground" Value="#FFD2A1" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="22,16,16,6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border BorderBrush="#405350" BorderThickness="0,0,0,1" Padding="0,0,6,11" Margin="0,0,0,14">
            <DockPanel LastChildFill="True">
                <Button x:Name="BackButton" DockPanel.Dock="Right" Style="{StaticResource BackButtonStyle}"
                        Content="‹  角色列表" Click="ShowCharacters" Visibility="Collapsed" VerticalAlignment="Center"
                        AutomationProperties.Name="返回角色列表" />
                <TextBlock x:Name="PageHeading" Text="選擇角色" FontSize="23" FontWeight="SemiBold"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
        <ScrollViewer x:Name="CardsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <StackPanel x:Name="CharacterPage">
                    <Label x:Name="SearchLabel" Content="搜尋角色名稱" Target="{Binding ElementName=CharacterSearch}"
                           Foreground="#D6E4DF" Padding="0,0,0,4" />
                    <TextBox x:Name="CharacterSearch" Margin="0,0,12,6" Padding="7,4"
                             Background="#263137" Foreground="#F5F5EE" BorderBrush="#495A60"
                             CaretBrush="#F5F5EE" TextChanged="FilterCharacters"
                             AutomationProperties.LabeledBy="{Binding ElementName=SearchLabel}" />
                    <ListBox x:Name="ProfessionFilter" Margin="0,0,10,12" Padding="0" Background="Transparent"
                             BorderThickness="0" SelectedValuePath="Id" SelectionChanged="FilterCharacters"
                             AutomationProperties.Name="職業篩選" ItemContainerStyle="{StaticResource ProfessionFilterItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Image x:Name="ProfessionIcon" Source="{Binding Icon}" Width="20" Height="20" />
                                    <TextBlock x:Name="AllLabel" Text="{Binding Name}" FontSize="11" Visibility="Collapsed"
                                               VerticalAlignment="Center" HorizontalAlignment="Center" />
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Id}" Value="">
                                        <Setter TargetName="ProfessionIcon" Property="Visibility" Value="Collapsed" />
                                        <Setter TargetName="AllLabel" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <ItemsControl x:Name="Characters" ItemsPanel="{StaticResource CardPanel}"
                                  KeyboardNavigation.DirectionalNavigation="Cycle">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource CardButton}" Click="ShowOutfits"
                                        AutomationProperties.Name="{Binding AccessibleName}"
                                        AutomationProperties.HelpText="{Binding PortraitStatus}">
                                    <StackPanel Width="170">
                                        <Grid Height="235" Background="{StaticResource PortraitBackground}" ClipToBounds="True">
                                            <Rectangle RenderOptions.BitmapScalingMode="HighQuality">
                                                <Rectangle.Fill>
                                                    <ImageBrush ImageSource="{Binding Portrait}" Stretch="UniformToFill" AlignmentY="Top" />
                                                </Rectangle.Fill>
                                            </Rectangle>
                                            <TextBlock Style="{StaticResource ImageStatus}" Text="{Binding PortraitStatus}" />
                                        </Grid>
                                        <StackPanel Margin="10,10,10,9">
                                            <TextBlock Text="{Binding DisplayName}" FontSize="17" FontWeight="SemiBold"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Status}" Style="{StaticResource SelectionStatus}" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="CharacterListStatus" Margin="0,5,6,10" Foreground="#D6E4DF"
                               Text="讀取角色素材…" TextWrapping="Wrap" />
                </StackPanel>
                <ItemsControl x:Name="Outfits" Visibility="Collapsed" ItemsPanel="{StaticResource CardPanel}"
                              KeyboardNavigation.DirectionalNavigation="Cycle">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource CardButton}" Click="ApplyOutfit" AutomationProperties.HelpText="{Binding PortraitStatus}"
                                    AutomationProperties.Name="{Binding AccessibleName}">
                                <StackPanel Width="170">
                                    <Grid Width="170" Height="170" Background="{StaticResource PreviewBackground}">
                                        <Image Source="{Binding Preview}" Stretch="Uniform" Margin="2"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                        <TextBlock Style="{StaticResource ImageStatus}" Text="{Binding PreviewStatus}" />
                                    </Grid>
                                    <Grid Height="235" ClipToBounds="True" Background="{StaticResource PortraitBackground}">
                                        <Image Source="{Binding Portrait}" Stretch="UniformToFill"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                        <TextBlock Style="{StaticResource ImageStatus}" Text="{Binding PortraitStatus}" Margin="0,0,0,52" />
                                        <Border Height="128" VerticalAlignment="Bottom" Background="{StaticResource PortraitCaptionShade}" />
                                        <StackPanel VerticalAlignment="Bottom" Margin="12,0,12,30">
                                            <TextBlock Text="{Binding DisplayName}" FontSize="18" FontWeight="SemiBold"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Status}" Style="{StaticResource SelectionStatus}" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </ScrollViewer>
        <StackPanel x:Name="ModelActions" Grid.Row="2" Visibility="Collapsed" Margin="0,8,6,8">
            <TextBlock x:Name="ModelStatus" Foreground="#D6E4DF" TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite" Margin="0,0,0,8" />
            <WrapPanel>
                <Button x:Name="BuildModelButton" Style="{StaticResource BackButtonStyle}"
                        Content="建置影格" Click="BuildModel" />
                <Button x:Name="DeleteModelButton" Style="{StaticResource BackButtonStyle}"
                        Content="刪除影格" Click="DeleteModel" Margin="8,0,0,0" />
            </WrapPanel>
        </StackPanel>
    </Grid>
</Window>
